                    android:padding="4dp"
                    android:scaleType="fitCenter" />
            </ViewFlipper>
            <ViewFlipper
                android:id="@+id/fl_1_4"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:autoStart="true"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:flipInterval="2000"
                android:inAnimation="@anim/fish_in"
                android:outAnimation="@anim/fish_out">

                <ImageView
                    android:id="@+id/fa_1_4"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="4dp"
                    android:scaleType="fitCenter" />

                <ImageView
                    android:id="@+id/fb_1_4"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="4dp"
                    android:scaleType="fitCenter" />
            </ViewFlipper>
            <ViewFlipper
                android:id="@+id/fl_1_5"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:autoStart="true"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:flipInterval="2800"
                android:inAnimation="@anim/fish_in"
                android:outAnimation="@anim/fish_out">

                <ImageView
                    android:id="@+id/fa_1_5"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
