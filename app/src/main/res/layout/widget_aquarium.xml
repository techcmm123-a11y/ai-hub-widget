<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_rows"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/thin_bg"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="6dp">

        <ImageView
            android:id="@+id/nav_prev"
            android:layout_width="36dp"
            android:layout_height="match_parent"
            android:contentDescription="@string/nav_prev_desc"
            android:padding="8dp"
            android:src="@drawable/ic_chevron_left"
            android:tint="@color/c_sub"
            android:visibility="gone" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:clipChildren="false"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/rows_a"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:clipChildren="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ViewFlipper
                android:id="@+id/fl_0_0"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:autoStart="true"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:flipInterval="2100"
                android:inAnimation="@anim/fish_in"
                android:outAnimation="@anim/fish_out">

                <ImageView
                    android:id="@+id/fa_0_0"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="4dp"
                    android:scaleType="fitCenter" />

                <ImageView
                    android:id="@+id/fb_0_0"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="4dp"
                    android:scaleType="fitCenter" />
            </ViewFlipper>
            <ViewFlipper
                android:id="@+id/fl_0_1"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:autoStart="true"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:flipInterval="2700"
                android:inAnimation="@anim/fish_in"
                android:outAnimation="@anim/fish_out">

                <ImageView
                    android:id="@+id/fa_0_1"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="4dp"
                    android:scaleType="fitCenter" />

                <ImageView
                    android:id="@+id/fb_0_1"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="4dp"
                    android:scaleType="fitCenter" />
            </ViewFlipper>
            <ViewFlipper
                android:id="@+id/fl_0_2"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:autoStart="true"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:flipInterval="2300"
                android:inAnimation="@anim/fish_in"
                android:outAnimation="@anim/fish_out">

                <ImageView
                    android:id="@+id/fa_0_2"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="4dp"
                    android:scaleType="fitCenter" />

                <ImageView
                    android:id="@+id/fb_0_2"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="4dp"
                    android:scaleType="fitCenter" />
            </ViewFlipper>
            <ViewFlipper
                android:id="@+id/fl_0_3"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:autoStart="true"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:flipInterval="3000"
                android:inAnimation="@anim/fish_in"
                android:outAnimation="@anim/fish_out">

                <ImageView
                    android:id="@+id/fa_0_3"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="4dp"
                    android:scaleType="fitCenter" />

                <ImageView
                    android:id="@+id/fb_0_3"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="4dp"
                    android:scaleType="fitCenter" />
            </ViewFlipper>
            <ViewFlipper
                android:id="@+id/fl_0_4"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:autoStart="true"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:flipInterval="2500"
                android:inAnimation="@anim/fish_in"
                android:outAnimation="@anim/fish_out">

                <ImageView
                    android:id="@+id/fa_0_4"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="4dp"
                    android:scaleType="fitCenter" />

                <ImageView
                    android:id="@+id/fb_0_4"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="4dp"
                    android:scaleType="fitCenter" />
            </ViewFlipper>
            <ViewFlipper
                android:id="@+id/fl_0_5"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:autoStart="true"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:flipInterval="2900"
                android:inAnimation="@anim/fish_in"
                android:outAnimation="@anim/fish_out">

                <ImageView
                    android:id="@+id/fa_0_5"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="4dp"
                    android:scaleType="fitCenter" />

                <ImageView
                    android:id="@+id/fb_0_5"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="4dp"
                    android:scaleType="fitCenter" />
            </ViewFlipper>
        </LinearLayout>
        <LinearLayout
