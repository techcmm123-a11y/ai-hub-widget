        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/nav_next"
            android:layout_width="36dp"
            android:layout_height="30dp"
            android:contentDescription="@string/nav_next_desc"
            android:padding="6dp"
            android:src="@drawable/ic_chevron_right"
            android:tint="@color/c_sub"
            android:visibility="gone" />
        <ImageView
            android:id="@+id/nav_shuffle"
            android:layout_width="36dp"
            android:layout_height="30dp"
            android:contentDescription="@string/nav_shuffle_desc"
            android:padding="6dp"
            android:src="@drawable/ic_shuffle"
            android:tint="@color/c_sub"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/empty_rows"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:text="@string/empty_hint"
        android:textColor="@color/c_sub"
        android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>
