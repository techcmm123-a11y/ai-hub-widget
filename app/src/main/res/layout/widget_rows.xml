<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_rows"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/thin_bg"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="6dp">

        <ImageView
            android:id="@+id/nav_prev"
            android:layout_width="36dp"
            android:layout_height="match_parent"
            android:contentDescription="@string/nav_prev_desc"
            android:padding="8dp"
            android:src="@drawable/ic_chevron_left"
            android:tint="@color/c_sub"
            android:visibility="gone" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:clipChildren="false"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/rows_a"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:clipChildren="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/rt_0_0"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:padding="4dp"
                android:scaleType="fitCenter" />
            <ImageView
                android:id="@+id/rt_0_1"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:padding="4dp"
                android:scaleType="fitCenter" />
            <ImageView
                android:id="@+id/rt_0_2"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:padding="4dp"
                android:scaleType="fitCenter" />
            <ImageView
                android:id="@+id/rt_0_3"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:padding="4dp"
                android:scaleType="fitCenter" />
            <ImageView
                android:id="@+id/rt_0_4"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:padding="4dp"
                android:scaleType="fitCenter" />
            <ImageView
                android:id="@+id/rt_0_5"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:padding="4dp"
                android:scaleType="fitCenter" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/rows_b"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:clipChildren="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/rt_1_0"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:padding="4dp"
                android:scaleType="fitCenter" />
            <ImageView
                android:id="@+id/rt_1_1"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:padding="4dp"
                android:scaleType="fitCenter" />
            <ImageView
                android:id="@+id/rt_1_2"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:padding="4dp"
                android:scaleType="fitCenter" />
            <ImageView
                android:id="@+id/rt_1_3"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:padding="4dp"
                android:scaleType="fitCenter" />
            <ImageView
                android:id="@+id/rt_1_4"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:padding="4dp"
                android:scaleType="fitCenter" />
            <ImageView
                android:id="@+id/rt_1_5"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:padding="4dp"
                android:scaleType="fitCenter" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/rows_c"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:clipChildren="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/rt_2_0"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:padding="4dp"
                android:scaleType="fitCenter" />
            <ImageView
                android:id="@+id/rt_2_1"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:padding="4dp"
                android:scaleType="fitCenter" />
            <ImageView
                android:id="@+id/rt_2_2"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:padding="4dp"
                android:scaleType="fitCenter" />
            <ImageView
                android:id="@+id/rt_2_3"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:padding="4dp"
                android:scaleType="fitCenter" />
            <ImageView
                android:id="@+id/rt_2_4"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:padding="4dp"
                android:scaleType="fitCenter" />
            <ImageView
                android:id="@+id/rt_2_5"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:padding="4dp"
                android:scaleType="fitCenter" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/rows_d"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:clipChildren="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/rt_3_0"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:padding="4dp"
                android:scaleType="fitCenter" />
            <ImageView
                android:id="@+id/rt_3_1"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:padding="4dp"
                android:scaleType="fitCenter" />
            <ImageView
                android:id="@+id/rt_3_2"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:padding="4dp"
                android:scaleType="fitCenter" />
            <ImageView
                android:id="@+id/rt_3_3"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:padding="4dp"
                android:scaleType="fitCenter" />
            <ImageView
                android:id="@+id/rt_3_4"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:padding="4dp"
                android:scaleType="fitCenter" />
            <ImageView
                android:id="@+id/rt_3_5"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:padding="4dp"
                android:scaleType="fitCenter" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/nav_next"
            android:layout_width="36dp"
            android:layout_height="30dp"
            android:contentDescription="@string/nav_next_desc"
            android:padding="6dp"
            android:src="@drawable/ic_chevron_right"
            android:tint="@color/c_sub"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/empty_rows"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:text="@string/empty_hint"
        android:textColor="@color/c_sub"
        android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>
