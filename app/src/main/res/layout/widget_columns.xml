<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_cols"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/thin_bg"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:padding="6dp">

    <LinearLayout
        android:id="@+id/vcols"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipChildren="false"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/vcol_0"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clipChildren="false"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/vt_0_0"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:padding="4dp"
                android:scaleType="fitCenter" />
            <ImageView
                android:id="@+id/vt_0_1"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:padding="4dp"
                android:scaleType="fitCenter" />
            <ImageView
                android:id="@+id/vt_0_2"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:padding="4dp"
                android:scaleType="fitCenter" />
            <ImageView
                android:id="@+id/vt_0_3"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:padding="4dp"
                android:scaleType="fitCenter" />
            <ImageView
                android:id="@+id/vt_0_4"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:padding="4dp"
                android:scaleType="fitCenter" />
            <ImageView
                android:id="@+id/vt_0_5"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:padding="4dp"
                android:scaleType="fitCenter" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/vcol_1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clipChildren="false"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/vt_1_0"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:padding="4dp"
                android:scaleType="fitCenter" />
            <ImageView
                android:id="@+id/vt_1_1"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:padding="4dp"
                android:scaleType="fitCenter" />
            <ImageView
                android:id="@+id/vt_1_2"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:padding="4dp"
                android:scaleType="fitCenter" />
            <ImageView
                android:id="@+id/vt_1_3"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:padding="4dp"
                android:scaleType="fitCenter" />
            <ImageView
                android:id="@+id/vt_1_4"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:padding="4dp"
                android:scaleType="fitCenter" />
            <ImageView
                android:id="@+id/vt_1_5"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:padding="4dp"
                android:scaleType="fitCenter" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/vnav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/vnav_prev"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_weight="1"
            android:contentDescription="@string/nav_prev_desc"
            android:padding="5dp"
            android:src="@drawable/ic_chevron_left"
            android:tint="@color/c_sub"
            android:visibility="gone" />
        <ImageView
            android:id="@+id/vnav_next"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_weight="1"
            android:contentDescription="@string/nav_next_desc"
            android:padding="5dp"
            android:src="@drawable/ic_chevron_right"
            android:tint="@color/c_sub"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/vempty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="8dp"
        android:text="@string/empty_hint"
        android:textColor="@color/c_sub"
        android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>
